schema: "crumb/v1"
repository: "aien-spark/synapse"
updated_at: "2026-10-14T14:05:00Z"
summary: "Synapse agent-native changeset service with Git and Radicle interoperability (aien-sovereign-core#515)"
components:
  - name: "synapse-core"
    path: "crates/synapse-core"
    role: "Distinct typed identities, canonical changeset envelope v1, refusal codes, and domain invariants"
  - name: "synapse-store"
    path: "crates/synapse-store"
    role: "Single-writer append-only WAL, content-addressed blob store, checkpointing, GC, and fault-injected recovery"
  - name: "synapse-auth"
    path: "crates/synapse-auth"
    role: "Ed25519 agent identity verification, capability-scoped grants, rate/size quotas, and hash-chained audit log"
  - name: "synapse-api"
    path: "crates/synapse-api"
    role: "Bounded paginated read/proposal API, virtual tree overlay without checkout, path-index invalidation, and watch cursors"
  - name: "synapse-git"
    path: "crates/synapse-git"
    role: "Deterministic Git blob/tree/commit materialization, bidirectional OID mapping, and GitHub PR projection metadata"
  - name: "synapse-radicle"
    path: "crates/synapse-radicle"
    role: "Radicle refs/rad/id and refs/rad/sigrefs Ed25519 delegate threshold verifier and split-brain refusal engine"
  - name: "synapse-bench"
    path: "crates/synapse-bench"
    role: "Comparative concurrent agent benchmark and conformance suite against Git worktree workflows"

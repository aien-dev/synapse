{
  "below": [
    {
      "name": "synapse-core",
      "role": "Distinct typed identities, canonical changeset envelope v1, refusal codes, and domain invariants"
    },
    {
      "name": "synapse-store",
      "role": "Single-writer append-only WAL, content-addressed blob store, checkpointing, GC, and fault-injected recovery"
    },
    {
      "name": "synapse-auth",
      "role": "Ed25519 agent identity verification, capability-scoped grants, rate/size quotas, and hash-chained audit log"
    },
    {
      "name": "synapse-api",
      "role": "Bounded paginated read/proposal API, virtual tree overlay without checkout, path-index invalidation, and watch cursors"
    },
    {
      "name": "synapse-git",
      "role": "Deterministic Git blob/tree/commit materialization, bidirectional OID mapping, and GitHub PR projection metadata"
    },
    {
      "name": "synapse-radicle",
      "role": "Radicle refs/rad/id and refs/rad/sigrefs Ed25519 delegate threshold verifier and split-brain refusal engine"
    },
    {
      "name": "synapse-bench",
      "role": "Gate 4 comparative qualification harness (Synapse versus Git worktree and plumbing workflows) and WAL, Git, and Radicle conformance suites"
    },
    {
      "name": "synapse-crumb",
      "role": "Strict bounded reader for Directory Crumb dialects and CrumbContext with its domain-separated digest over Synapse snapshots (ADR 0004)"
    },
    {
      "name": "synapse-coord",
      "role": "Shared agent coordination plane (claims, presence, whispers) byte-compatible with the crumb.c RFC-0002 store; never history, evidence, or authority (ADR 0004)"
    },
    {
      "name": "synapse-wire",
      "role": "Binary wire frames with a fuzzed decoder, have-want chunk negotiation, and stream transports (ADR 0003 step G1)"
    }
  ],

# tests/gates/synapse-conformance.gate
# RETIRED (2026-10-19, Drake: "drop the check"): this gate qualified synapse-crumb and synapse-coord against
# the pinned crumb.c (aien-architecture 29780e5) and its claims store, which RFC-0003 Amendment 2 retired.
# The manifest stays only because the planner refuses a head that deletes a gate that exists at its base
# (GATE_REMOVED). The step checks nothing and passes. The scripts and evidence are kept as history.
gate: SYNAPSE-CONFORMANCE
manifest_version: 2
owner: synapse
requires:
  - portable
inputs:
  - tests/gates/synapse-conformance.gate
run:
  exec: tests/gates/run.sh
  args: ["conformance"]
expects:
  exit: 0
  verdict: PASS
timeout: 1m
exactness: EXACT
cache_scope: portable

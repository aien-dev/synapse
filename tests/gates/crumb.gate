# tests/gates/crumb.gate
# Mirrors hosted: aien-verification.yml step 'crumb verify .' with the tool built from crumb.lock
# (the same commit the thin gate pins). synapse had no hosted crumb job before phase 3.
# requires host, not portable: the step builds crumb from the sibling ../aien-architecture checkout at the
# crumb.lock commit, and a gate that needs a sibling is a host gate (LOCAL_VERIFICATION.md, sibling checkouts).
# cache: never because the check reads the sibling checkout; it is sub-second.
gate: CRUMB-VERIFY
manifest_version: 2
owner: synapse
requires:
  - host
inputs:
  - .crumb
  - crumb.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["crumb-verify"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: machine
cache: never
